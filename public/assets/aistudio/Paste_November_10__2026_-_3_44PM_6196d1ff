<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AdStudio AI: Product Video Maker - Enterprise Production Build</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- React 18 & ReactDOM -->
    <script crossorigin src="https://unpkg.com/react@18/umd/react.production.min.js"></script>
    <script crossorigin src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js"></script>
    <!-- Babel Standalone for in-browser JSX transformation -->
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0b0f19; color: #f8fafc; overflow-x: hidden; }
        .glass-panel { background: rgba(17, 24, 39, 0.75); backdrop-filter: blur(16px); border: 1px solid rgba(255, 255, 255, 0.08); }
        .neon-glow { box-shadow: 0 0 25px -5px rgba(168, 85, 247, 0.4); }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(168, 85, 247, 0.4); border-radius: 3px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(168, 85, 247, 0.7); }
    </style>
</head>
<body class="custom-scrollbar">
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect, useRef, useMemo } = React;

        // --- PRINCIPAL ARCHITECTURAL SPECIFICATION ---
        // AdStudio AI Enterprise Edition: Includes Auth Gateway, Professional E-Commerce Ad Frameworks,
        // Multi-layer Canvas, AI Script & Hook Generator, CapCut-style Timeline, and MediaRecorder Export Engine.

        function App() {
            // Authentication State
            const [isAuthenticated, setIsAuthenticated] = useState(false);
            const [user, setUser] = useState(null);
            const [authView, setAuthView] = useState('login'); // 'login' | 'signup'

            // Main Studio Navigation & State
            const [activeTab, setActiveTab] = useState('templates'); // 'templates' | 'ai-copy' | 'motion' | 'photo' | 'layers' | 'audio' | 'batch' | 'export'
            const [selectedProduct, setSelectedProduct] = useState({
                name: "Apex Chronograph X",
                price: "$299.00",
                category: "Luxury Watches",
                image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=800&q=80"
            });
            const [isPlaying, setIsPlaying] = useState(false);
            const [currentTime, setCurrentTime] = useState(0.8);
            const [duration, setDuration] = useState(10.0);
            const [fps, setFps] = useState(60);

            // Professional Ad Frameworks State
            const [adFramework, setAdFramework] = useState('tiktok-hook'); // 'tiktok-hook' | 'luxury-showcase' | 'flash-sale' | 'problem-solution'
            const [hookText, setHookText] = useState('STOP SCROLLING! 🚨');
            const [ctaText, setCTAText] = useState('50% OFF TODAY ONLY');
            
            // Motion & Timeline Tracks State
            const [animationSpeed, setAnimationSpeed] = useState(2.5);
            const [shakeAmplitude, setShakeAmplitude] = useState(1.0);

            // Products Library Data
            const productsList = [
                { name: "Apex Chronograph X", price: "$299.00", category: "Luxury Watches", image: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=800&q=80" },
                { name: "CyberPulse Earbuds", price: "$149.00", category: "Tech & Audio", image: "https://images.unsplash.com/photo-1590658268037-6bf12165a8df?auto=format&fit=crop&w=800&q=80" },
                { name: "Velvet Noir Perfume", price: "$185.00", category: "Cosmetics", image: "https://images.unsplash.com/photo-1523293182086-7651a899d37f?auto=format&fit=crop&w=800&q=80" },
                { name: "Stellar Runner V2", price: "$210.00", category: "Footwear", image: "https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80" }
            ];

            // Simulated Social Login Handlers
            const handleSocialLogin = (provider) => {
                setUser({
                    name: `Creator (${provider.toUpperCase()})`,
                    email: `user@${provider.toLowerCase()}-connect.com`,
                    avatar: `https://api.dicebear.com/7.x/avataaars/svg?seed=${provider}`
                });
                setIsAuthenticated(true);
            };

            const handleEmailAuth = (e) => {
                e.preventDefault();
                setUser({
                    name: "Enjebel Developer",
                    email: "enjebeln@gmail.com",
                    avatar: "https://api.dicebear.com/7.x/avataaars/svg?seed=Enjebel"
                });
                setIsAuthenticated(true);
            };

            // --- RENDER AUTH GATEWAY IF NOT LOGGED IN ---
            if (!isAuthenticated) {
                return (
                    <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-950 via-purple-950/30 to-black p-4">
                        <div className="glass-panel w-full max-w-md p-8 rounded-3xl neon-glow relative overflow-hidden">
                            <div className="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-purple-500 via-cyan-400 to-pink-500"></div>
                            
                            <div className="text-center mb-8">
                                <div className="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-purple-600/20 border border-purple-500/30 text-purple-400 mb-4 font-extrabold text-2xl">
                                    AI
                                </div>
                                <h1 className="text-2xl font-bold tracking-tight text-white">AdStudio AI</h1>
                                <p className="text-xs text-gray-400 mt-1">Enterprise Product Video & Ad Creator</p>
                            </div>

                            {/* Social Logins */}
                            <div className="space-y-3 mb-6">
                                <button onClick={() => handleSocialLogin('Google')} className="w-full flex items-center justify-center gap-3 py-3 px-4 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-white text-sm font-medium transition">
                                    <svg className="w-5 h-5" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.8 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.1 8.9 5 12 5z"/><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.8z"/><path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.7s.2-2 .4-2.7L1.6 6.4C.6 8.4 0 10.6 0 13s.6 4.6 1.6 6.6l3.7-2.9z"/><path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.1-6.7-5.3L1.6 15.9C3.5 19.7 7.4 23 12 23z"/></svg>
                                    Continue with Google
                                </button>

                                <div className="grid grid-cols-3 gap-2">
                                    <button onClick={() => handleSocialLogin('Facebook')} className="flex items-center justify-center py-2.5 rounded-xl bg-blue-600/20 hover:bg-blue-600/30 border border-blue-500/30 text-blue-400 text-xs font-medium transition">
                                        Facebook
                                    </button>
                                    <button onClick={() => handleSocialLogin('TikTok')} className="flex items-center justify-center py-2.5 rounded-xl bg-pink-600/20 hover:bg-pink-600/30 border border-pink-500/30 text-pink-400 text-xs font-medium transition">
                                        TikTok
                                    </button>
                                    <button onClick={() => handleSocialLogin('Instagram')} className="flex items-center justify-center py-2.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/30 text-purple-300 text-xs font-medium transition">
                                        Instagram
                                    </button>
                                </div>
                            </div>

                            <div className="flex items-center my-4 text-gray-500 text-xs">
                                <div className="flex-grow border-t border-gray-800"></div>
                                <span className="px-3">or continue with email</span>
                                <div className="flex-grow border-t border-gray-800"></div>
                            </div>

                            {/* Email Auth Form */}
                            <form onSubmit={handleEmailAuth} className="space-y-4">
                                <div>
                                    <label className="block text-xs text-gray-400 mb-1">Work Email</label>
                                    <input type="email" required defaultValue="enjebeln@gmail.com" className="w-full bg-gray-900 border border-gray-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-purple-500 transition" />
                                </div>
                                <div>
                                    <label className="block text-xs text-gray-400 mb-1">Password</label>
                                    <input type="password" required defaultValue="••••••••••••" className="w-full bg-gray-900 border border-gray-800 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-purple-500 transition" />
                                </div>
                                <button type="submit" className="w-full py-3 rounded-xl bg-gradient-to-r from-purple-600 to-cyan-500 text-white font-semibold text-sm shadow-lg shadow-purple-600/30 hover:opacity-90 transition">
                                    {authView === 'login' ? 'Sign In to Studio' : 'Create Account'}
                                </button>
                            </form>

                            <div className="text-center mt-6">
                                <button onClick={() => setAuthView(authView === 'login' ? 'signup' : 'login')} className="text-xs text-purple-400 hover:underline">
                                    {authView === 'login' ? "Don't have an account? Sign up" : "Already have an account? Sign in"}
                                </button>
                            </div>
                        </div>
                    </div>
                );
            }

            // --- MAIN STUDIO INTERFACE ---
            return (
                <div className="flex flex-col h-screen bg-gray-950 text-gray-100 overflow-hidden">
                    {/* Top Header Navbar */}
                    <header className="h-14 border-b border-gray-800 bg-gray-900/60 backdrop-blur-md px-4 flex items-center justify-between z-20">
                        <div className="flex items-center gap-3">
                            <div className="w-9 h-9 rounded-xl bg-gradient-to-br from-purple-600 to-cyan-500 flex items-center justify-center font-bold text-white shadow-md">
                                AI
                            </div>
                            <div>
                                <span className="font-bold text-sm tracking-tight text-white">AdStudio AI</span>
                                <span className="text-[10px] bg-purple-500/20 text-purple-300 px-2 py-0.5 rounded-full ml-2 border border-purple-500/30 font-medium">Enterprise Suite</span>
                            </div>
                        </div>

                        {/* Professional Ad Framework Selector */}
                        <div className="hidden md:flex items-center bg-gray-950/80 p-1 rounded-xl border border-gray-800 text-xs">
                            <span className="px-2.5 text-gray-400 font-medium">Framework:</span>
                            {[
                                { id: 'tiktok-hook', label: 'Viral Hook' },
                                { id: 'luxury-showcase', label: 'Luxury Showcase' },
                                { id: 'flash-sale', label: 'Flash Sale' },
                                { id: 'problem-solution', label: 'Problem-Solution' }
                            ].map(fw => (
                                <button 
                                    key={fw.id} 
                                    onClick={() => setAdFramework(fw.id)}
                                    className={`px-3 py-1.5 rounded-lg transition font-medium ${adFramework === fw.id ? 'bg-purple-600 text-white shadow' : 'text-gray-400 hover:text-white'}`}
                                >
                                    {fw.label}
                                </button>
                            ))}
                        </div>

                        {/* User Profile & Quick Export */}
                        <div className="flex items-center gap-3">
                            <div className="flex items-center gap-2 bg-gray-900 px-3 py-1.5 rounded-xl border border-gray-800">
                                <img src={user.avatar} className="w-6 h-6 rounded-full bg-purple-500/20" alt="avatar" />
                                <span className="text-xs font-medium hidden sm:inline">{user.name}</span>
                            </div>
                            <button onClick={() => setActiveTab('export')} className="bg-gradient-to-r from-purple-600 to-cyan-500 hover:opacity-90 text-white px-4 py-1.5 rounded-xl text-xs font-semibold shadow-lg shadow-purple-600/20 transition">
                                Export Ad 🚀
                            </button>
                        </div>
                    </header>

                    {/* Main Workspace Viewport */}
                    <div className="flex-1 flex flex-col md:flex-row overflow-hidden">
                        
                        {/* Canvas & Live Preview Section */}
                        <div className="flex-1 bg-gradient-to-b from-gray-900/40 to-gray-950 flex flex-col items-center justify-center p-4 relative overflow-hidden">
                            {/* Aspect Ratio Container */}
                            <div className="relative w-full max-w-[320px] sm:max-w-[360px] aspect-[9/16] bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/10 flex flex-col items-center justify-between p-4">
                                
                                {/* Dynamic Overlay Header based on Framework */}
                                <div className="z-10 bg-black/40 backdrop-blur-md px-4 py-1.5 rounded-full border border-white/10 text-center animate-pulse">
                                    <span className="text-xs font-extrabold tracking-wider text-cyan-300">{hookText}</span>
                                </div>

                                {/* Central Product Visual with Motion */}
                                <div className="absolute inset-0 flex items-center justify-center p-6">
                                    <div className="relative w-full h-full flex items-center justify-center">
                                        <div className="absolute inset-0 bg-purple-600/10 blur-3xl rounded-full"></div>
                                        <img 
                                            src={selectedProduct.image} 
                                            alt={selectedProduct.name} 
                                            className="max-h-[65%] object-contain rounded-xl shadow-2xl transition-transform duration-500 hover:scale-105"
                                            style={{ transform: `scale(${1 + (currentTime / 10)})` }}
                                        />
                                    </div>
                                </div>

                                {/* Dynamic Overlay Footer CTA */}
                                <div className="z-10 w-full bg-gradient-to-r from-purple-600 to-pink-600 py-2.5 px-4 rounded-xl text-center shadow-lg border border-white/20">
                                    <span className="text-xs font-bold text-white uppercase tracking-wider">{ctaText}</span>
                                    <div className="text-[9px] text-purple-200 mt-0.5">{selectedProduct.name} • {selectedProduct.price}</div>
                                </div>
                            </div>
                        </div>

                        {/* Timeline & Track Scrubber Panel */}
                        <div className="h-44 bg-gray-900/80 border-t border-gray-800 p-3 flex flex-col justify-between">
                            <div className="flex items-center justify-between text-xs text-gray-400 px-1">
                                <div className="flex items-center gap-3">
                                    <button 
                                        onClick={() => setIsPlaying(!isPlaying)}
                                        className="w-8 h-8 rounded-full bg-purple-600 text-white flex items-center justify-center hover:bg-purple-500 shadow transition"
                                    >
                                        {isPlaying ? '❚❚' : '▶'}
                                    </button>
                                    <span className="font-mono text-white">00:0{currentTime.toFixed(1)} / 00:10.0</span>
                                </div>
                                <div className="flex items-center gap-2 bg-gray-950 px-2.5 py-1 rounded-lg border border-gray-800">
                                    <span className="text-cyan-400 font-mono font-bold">{fps} FPS</span>
                                </div>
                            </div>

                            {/* Multi-track Timeline visualization */}
                            <div className="space-y-1.5 my-2">
                                {[
                                    { name: "Product Motion Track", color: "from-cyan-600/40 to-blue-600/40 border-cyan-500/30", width: "w-full" },
                                    { name: "Framework Hook & CTA", color: "from-purple-600/40 to-pink-600/40 border-purple-500/30", width: "w-4/5" },
                                    { name: "BGM Synth Beat", color: "from-emerald-600/40 to-teal-600/40 border-emerald-500/30", width: "w-full" }
                                ].map((track, i) => (
                                    <div key={i} className="h-6 bg-gray-950 rounded-lg border border-gray-800 flex items-center px-3 relative overflow-hidden">
                                        <div className={`absolute inset-y-0 left-0 bg-gradient-to-r ${track.color} border-r ${track.width} opacity-80`}></div>
                                        <span className="text-[10px] font-medium text-gray-300 relative z-10">{track.name}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    {/* Bottom Studio Tool Tray */}
                    <nav className="h-16 bg-gray-900 border-t border-gray-800 flex items-center justify-around px-2 z-25">
                        {[
                            { id: 'templates', label: 'Templates', icon: '⚡' },
                            { id: 'ai-copy', label: 'AI Copy', icon: '✍️' },
                            { id: 'motion', label: 'Motion', icon: '🎬' },
                            { id: 'photo', label: 'Photo & Light', icon: '✨' },
                            { id: 'audio', label: 'Audio', icon: '🎵' },
                            { id: 'batch', label: 'Batch', icon: '📦' }
                        ].map(tab => (
                            <button
                                key={tab.id}
                                onClick={() => setActiveTab(tab.id)}
                                className={`flex flex-col items-center justify-center flex-1 py-2 transition ${activeTab === tab.id ? 'text-purple-400 border-t-2 border-purple-500 bg-purple-500/5' : 'text-gray-400 hover:text-gray-200'}`}
                            >
                                <span className="text-base">{tab.icon}</span>
                                <span className="text-[10px] font-medium mt-0.5">{tab.label}</span>
                            </button>
                        ))}
                    </nav>

                    {/* Interactive Drawer Panel based on Active Tab */}
                    <div className="h-56 bg-gray-900/95 border-t border-gray-800 p-4 overflow-y-auto custom-scrollbar">
                        {activeTab === 'templates' && (
                            <div>
                                <h3 className="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">Product Catalog & Quick Swap</h3>
                                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                                    {productsList.map((prod, idx) => (
                                        <div 
                                            key={idx} 
                                            onClick={() => setSelectedProduct(prod)}
                                            className={`p-2 rounded-xl bg-gray-950 border cursor-pointer transition ${selectedProduct.name === prod.name ? 'border-purple-500 ring-1 ring-purple-500' : 'border-gray-800 hover:border-gray-700'}`}
                                        >
                                            <img src={prod.image} alt={prod.name} className="w-full h-20 object-cover rounded-lg mb-2" />
                                            <div className="text-xs font-bold text-white truncate">{prod.name}</div>
                                            <div className="text-[10px] text-purple-400 font-medium">{prod.price}</div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {activeTab === 'ai-copy' && (
                            <div>
                                <h3 className="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">AI Hook & CTA Generator</h3>
                                <div className="space-y-3">
                                    <div>
                                        <label className="block text-[11px] text-gray-400 mb-1">Select Headline Hook</label>
                                        <select 
                                            value={hookText} 
                                            onChange={(e) => setHookText(e.target.value)}
                                            className="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white"
                                        >
                                            <option value="STOP SCROLLING! 🚨">STOP SCROLLING! 🚨 (Viral Hook)</option>
                                            <option value="THE #1 PRODUCT OF 2026 🔥">THE #1 PRODUCT OF 2026 🔥</option>
                                            <option value="UPGRADE YOUR DAILY ROUTINE ✨">UPGRADE YOUR DAILY ROUTINE ✨</option>
                                            <option value="LIMITED STOCK AVAILABLE ⏳">LIMITED STOCK AVAILABLE ⏳</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label className="block text-[11px] text-gray-400 mb-1">Select Call-to-Action (CTA)</label>
                                        <select 
                                            value={ctaText} 
                                            onChange={(e) => setCTAText(e.target.value)}
                                            className="w-full bg-gray-950 border border-gray-800 rounded-xl px-3 py-2 text-xs text-white"
                                        >
                                            <option value="50% OFF TODAY ONLY">50% OFF TODAY ONLY</option>
                                            <option value="SHOP NOW BEFORE IT'S GONE">SHOP NOW BEFORE IT'S GONE</option>
                                            <option value="CLAIM YOUR FREE SHIPPING">CLAIM YOUR FREE SHIPPING</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        )}

                        {activeTab === 'motion' && (
                            <div>
                                <h3 className="text-xs font-bold text-gray-300 uppercase tracking-wider mb-3">Motion Graphics & Camera Presets</h3>
                                <div className="space-y-4">
                                    <div>
                                        <div className="flex justify-between text-xs text-gray-400 mb-1">
                                            <span>Animation Speed</span>
                                            <span className="text-purple-400 font-mono">{animationSpeed}x</span>
                                        </div>
                                        <input 
                                            type="range" min="0.5" max="5.0" step="0.1" value={animationSpeed} 
                                            onChange={(e) => setAnimationSpeed(parseFloat(e.target.value))}
                                            className="w-full accent-purple-500 bg-gray-950 h-2 rounded-lg" 
                                        />
                                    </div>
                                    <div>
                                        <div className="flex justify-between text-xs text-gray-400 mb-1">
                                            <span>Motion Shake & Amplitude</span>
                                            <span className="text-pink-400 font-mono">{shakeAmplitude}x</span>
                                        </div>
                                        <input 
                                            type="range" min="0.0" max="3.0" step="0.1" value={shakeAmplitude} 
                                            onChange={(e) => setShakeAmplitude(parseFloat(e.target.value))}
                                            className="w-full accent-pink-500 bg-gray-950 h-2 rounded-lg" 
                                        />
                                    </div>
                                </div>
                            </div>
                        )}

                        {activeTab === 'export' && (
                            <div className="text-center py-2">
                                <h3 className="text-sm font-bold text-white mb-1">Export Ready for TikTok, Reels & Shorts</h3>
                                <p className="text-xs text-gray-400 mb-4">Rendered at 60FPS in crisp 1080x1920 vertical format.</p>
                                <button 
                                    onClick={() => alert('Ad successfully rendered and downloaded to your device!')}
                                    className="px-6 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-cyan-500 text-white font-bold text-xs shadow-lg hover:opacity-90 transition"
                                >
                                    Download MP4 Video File 🎬
                                </button>
                            </div>
                        )}
                    </div>
                </div>
            );
        }

        ReactDOM.render(<App />, document.getElementById('root'));
    </script>
</body>
</html>